module clock_divider #(parameter divider = 10)(
	input clk,
  	output reg clk_out
	);
  
  integer count = 0;
  
  initial clk_out = 0;
  
  
  always @(posedge clk) begin
    if (count== divider/2 - 1) begin
         clk_out = ~clk_out;
      	 count <= 0;
      end
    
      else
        count <= count+1;
    
  end
  
endmodule